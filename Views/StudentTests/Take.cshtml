@model StudentTestTakeViewModel
@{
    ViewData["Title"] = "Прохождение теста";
}

<h1 class="h3 mb-0">Тест: @Model.LectureTitle</h1>
<div class="text-muted mb-3">
    @Model.DisciplineName · Попытка @Model.AttemptNumber из @Model.MaxAttempts · Проходной балл @Model.PassingPercentage%
</div>

<form asp-action="Submit" method="post"
      data-confirm="Завершить тест и отправить ответы? Изменить их после отправки будет нельзя.">
    <input type="hidden" name="attemptId" value="@Model.AttemptId" />

    @foreach (var question in Model.Questions)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <p class="fw-semibold">@question.Number. @question.Text</p>

                @foreach (var option in question.Options)
                {
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="radio"
                               name="Answers[@(question.Id)]"
                               id="q@(question.Id)_o@(option.Id)"
                               value="@option.Id" required />
                        <label class="form-check-label" for="q@(question.Id)_o@(option.Id)">@option.Text</label>
                    </div>
                }
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary btn-lg">Завершить тест</button>
</form>