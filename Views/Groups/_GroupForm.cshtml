@model GroupFormViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="например, ИС-21" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="SpecialtyId" class="form-label"></label>
    <select asp-for="SpecialtyId" class="form-select"
            asp-items="@(new SelectList(Model.Specialties, "Id", "Name", Model.SpecialtyId))">
        <option value="">Выберите специальность...</option>
    </select>
    <span asp-validation-for="SpecialtyId" class="text-danger"></span>
    @if (!Model.Specialties.Any())
    {
        <div class="form-text text-danger">
            Специальностей пока нет. <a asp-controller="Specialties" asp-action="Create">Добавить специальность</a>
        </div>
    }
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>