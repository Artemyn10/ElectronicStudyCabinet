@model List<TopicOverviewRowViewModel>
@{
    ViewData["Title"] = "Темы";
    var search = ViewData["Search"] as string;
}

<h1 class="h3 mb-3">Темы</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Поиск по названию темы" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Тем не найдено. Темы добавляются на странице дисциплины.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Дисциплина</th>
                    <th style="width: 6rem;">Порядок</th>
                    <th>Тема</th>
                    <th class="text-center">Лекций</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DisciplineName</td>
                        <td>@item.OrderIndex</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="text-center">@item.LecturesCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Disciplines" asp-action="Details" asp-route-id="@item.DisciplineId"
                               class="btn btn-sm btn-outline-primary">Лекции</a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">Изменить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}