@{
    // Страницы этих контроллеров открываются в шаблоне панели преподавателя
    var teacherControllers = new[]
{
        "Teacher", "Disciplines", "Topics", "Lectures",
        "ControlQuestions", "Tests", "Reviews",
        "Students", "Results", "Progress", "Reports", "Audit",
        "Groups", "Specialties"
    };

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    Layout = User.IsInRole(AppRoles.Teacher) && teacherControllers.Contains(currentController)
        ? "_TeacherLayout"
        : "_Layout";
}