@model StudentDisciplineViewModel
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Index">Мой кабинет</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<h1 class="h3">@Model.Name</h1>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p class="text-muted">@Model.Description</p>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-1">
            <span>Всего лекций: <strong>@Model.TotalLectures</strong> · Завершено: <strong>@Model.CompletedLectures</strong></span>
            <strong>Прогресс: @Model.ProgressPercent%</strong>
        </div>
        <div class="progress" style="height: 0.8rem;">
            <div class="progress-bar bg-success" style="width: @(Model.ProgressPercent)%"></div>
        </div>
    </div>
</div>

@if (!Model.Topics.Any())
{
    <div class="alert alert-info">В этой дисциплине пока нет опубликованных лекций.</div>
}

@foreach (var topic in Model.Topics)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">@topic.Name</div>
        <div class="list-group list-group-flush">
            @foreach (var lecture in topic.Lectures)
            {
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 @(lecture.IsLocked ? "lecture-item-locked" : "")">
                    <div>
                        <span class="text-muted me-2">№@lecture.Number</span>

                        @if (lecture.IsLocked)
                        {
                            <span>@lecture.Title</span>
                            <div class="small text-muted">Откроется после завершения предыдущей лекции</div>
                        }
                        else
                        {
                            <a asp-action="Lecture" asp-route-id="@lecture.LectureId"
                               class="fw-semibold text-decoration-none">@lecture.Title</a>
                        }
                    </div>

                    <partial name="_LectureStatusBadge" model="lecture.Status" />
                </div>
            }
        </div>
    </div>
}