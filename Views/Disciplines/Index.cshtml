@model List<DisciplineListItemViewModel>
@{
    ViewData["Title"] = "Дисциплины";
    var search = ViewData["Search"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Дисциплины</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить дисциплину</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Поиск по названию дисциплины" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Дисциплин не найдено.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Название</th>
                    <th>Статус</th>
                    <th class="text-center">Тем</th>
                    <th class="text-center">Лекций</th>
                    <th>Создана</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">@item.Name</a>
                        </td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">Опубликована</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Черновик</span>
                            }
                        </td>
                        <td class="text-center">@item.TopicsCount</td>
                        <td class="text-center">@item.LecturesCount</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Открыть</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  data-confirm="Удалить дисциплину «@item.Name»?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}