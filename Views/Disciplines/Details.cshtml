@model DisciplineDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Дисциплины</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
                <h1 class="h3">@Model.Name</h1>
                @if (Model.IsPublished)
                {
                    <span class="badge bg-success">Опубликована</span>
                }
                else
                {
                    <span class="badge bg-secondary">Черновик</span>
                }
                <span class="text-muted small ms-2">Создана @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Изменить</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mt-3 mb-0">@Model.Description</p>
        }
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0">Темы</h2>
    <a asp-controller="Topics" asp-action="Create" asp-route-disciplineId="@Model.Id" class="btn btn-primary">Добавить тему</a>
</div>

@if (!Model.Topics.Any())
{
    <div class="alert alert-info">В этой дисциплине пока нет тем.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th style="width: 6rem;">Порядок</th>
                    <th>Название</th>
                    <th class="text-center">Лекций</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var topic in Model.Topics)
                {
                    <tr>
                        <td>@topic.OrderIndex</td>
                        <td>
                            <div class="fw-semibold">@topic.Name</div>
                            @if (!string.IsNullOrWhiteSpace(topic.Description))
                            {
                                <div class="text-muted small">@topic.Description</div>
                            }
                        </td>
                        <td class="text-center">@topic.LecturesCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Topics" asp-action="Edit" asp-route-id="@topic.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <form asp-controller="Topics" asp-action="Delete" asp-route-id="@topic.Id" method="post" class="d-inline"
                                  data-confirm="Удалить тему «@topic.Name»?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p class="text-muted small">Добавление лекций в темы появится на следующем этапе.</p>