@model List<LectureRowViewModel>
@{
    ViewData["Title"] = "Учебные материалы";
    var search = ViewData["Search"] as string;
    var missingOnly = ViewData["MissingOnly"] is true;
    var withoutFile = Model.Count(i => string.IsNullOrEmpty(i.MaterialFileName));
}

<h1 class="h3 mb-1">Учебные материалы</h1>
<p class="text-muted">Показано лекций: @Model.Count · без файла: @withoutFile</p>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-12 col-md-5">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Поиск по названию лекции" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="missingOnly" value="true" id="missingOnly"
                   checked="@missingOnly" />
            <label class="form-check-label" for="missingOnly">Только без файла</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Показать</button>
        <a asp-action="Materials" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Лекций не найдено.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Лекция</th>
                    <th>Дисциплина / тема</th>
                    <th>Файл</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>
                            @item.DisciplineName
                            <div class="text-muted small">@item.TopicName</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.MaterialFileName))
                            {
                                <span>@item.MaterialFileName</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">нет файла</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!string.IsNullOrEmpty(item.MaterialFileName))
                            {
                                <a asp-controller="Materials" asp-action="Download" asp-route-id="@item.Id"
                                   target="_blank" class="btn btn-sm btn-outline-primary">Открыть</a>
                                <a asp-controller="Materials" asp-action="Download" asp-route-id="@item.Id"
                                   asp-route-download="true" class="btn btn-sm btn-outline-secondary">Скачать</a>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                @(string.IsNullOrEmpty(item.MaterialFileName) ? "Загрузить" : "Заменить")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}