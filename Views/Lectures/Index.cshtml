@model List<LectureRowViewModel>
@{
    ViewData["Title"] = "Лекции";
    var search = ViewData["Search"] as string;
}

<h1 class="h3 mb-3">Лекции</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Поиск по названию лекции" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Лекций не найдено. Лекции добавляются в темах на странице дисциплины.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Лекция</th>
                    <th>Дисциплина / тема</th>
                    <th>Материал</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>
                            <a asp-controller="Disciplines" asp-action="Details" asp-route-id="@item.DisciplineId"
                               class="text-decoration-none">@item.DisciplineName</a>
                            <div class="text-muted small">@item.TopicName</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.MaterialFileName))
                            {
                                <a asp-controller="Materials" asp-action="Download" asp-route-id="@item.Id"
                                   target="_blank" class="text-decoration-none">@item.MaterialFileName</a>
                            }
                            else
                            {
                                <span class="text-muted">нет файла</span>
                            }
                        </td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">Опубликована</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Черновик</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}