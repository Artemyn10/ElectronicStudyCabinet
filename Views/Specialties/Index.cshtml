@model List<SpecialtyRowViewModel>
@{
    ViewData["Title"] = "Специальности";
    var search = ViewData["Search"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Специальности</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить специальность</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input type="text" name="search" value="@search" class="form-control"
               placeholder="Поиск по названию или коду специальности" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Найти</button>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Специальностей не найдено.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Специальность</th>
                    <th>Код</th>
                    <th class="text-center">Групп</th>
                    <th class="text-center">Студентов</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@(string.IsNullOrEmpty(item.Code) ? "—" : item.Code)</td>
                        <td class="text-center">
                            @if (item.GroupsCount > 0)
                            {
                                <a asp-controller="Groups" asp-action="Index" asp-route-specialtyId="@item.Id"
                                   class="text-decoration-none">@item.GroupsCount</a>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                        <td class="text-center">@item.StudentsCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  data-confirm="Удалить специальность «@item.Name»?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}